                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Fournisseur Alpha\",\n  \"taxId\": \"TAX-ALPHA-001\",\n  \"country\": \"Maroc\",\n  \"bankAccount\": \"MA12-0001-0000-1234-5678-9012\"\n}"
